# Pin this value deliberately when upgrading OpenCode.
OPENCODE_VERSION=1.18.29
OPENCODE_IMAGE_DIGEST=sha256:ecc3bf96ee55dad226d9cde50d79aaa8a1215c47860c0fcdc71570461bf438b8
PLAYWRIGHT_MCP_VERSION=v0.0.80
PLAYWRIGHT_MCP_IMAGE_DIGEST=sha256:dda1f7f9b812e22946635c8af7df9288b96d3b9e3f0f1b8576d6823e2031c1de

# Absolute path containing repositories; mounted at this same container path.
WORKSPACE_DIR=/home/${USER}/Projects

# setup.sh derives these from the invoking user (SUDO_USER when using sudo).
# Do not assume 1000:1000; use id -u and id -g for your normal host account.
HOST_UID=
HOST_GID=

# Replace this with a long, randomly generated value. Never commit .env.
OPENCODE_SERVER_PASSWORD=replace-with-at-least-32-random-characters

# Optional hosted MCP credentials. setup.sh prompts without echoing input.
EXA_API_KEY=
CONTEXT7_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=
POSTMAN_API_KEY=
